# Base URL the browser uses for API calls. Leave empty to call /api on the same origin
# (the default for local development, where the Vite dev server proxies /api to the API).
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api requests. Defaults to the API's "http" launch profile.
VITE_API_PROXY_TARGET=http://localhost:5021
