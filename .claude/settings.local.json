{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "powershell -NoProfile -Command \"[console]::beep(800,300)\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && dotnet build MovieLogger.slnx --nologo -v q 1>&2 || exit 2" }
        ]
      }
    ]
  }
}