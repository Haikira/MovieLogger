{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "MovieLogger",
    "Audience": "MovieLoggerClient",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Registration": {
    "Enabled": true
  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerMinute": 300,
    "LoginAttemptsPerFiveMinutes": 10,
    "RegistrationsPerHour": 5
  }
}
